# ============================================================
# CocheraYa — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como .env y completa los valores.
# ============================================================

# --- Base de Datos PostgreSQL / PostGIS ---
POSTGRES_DB=cocheraya_db
POSTGRES_USER=cocheraya_user
POSTGRES_PASSWORD=cocheraya_pass
POSTGRES_PORT=5432

# --- Spring Datasource ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cocheraya_db
SPRING_DATASOURCE_USERNAME=cocheraya_user
SPRING_DATASOURCE_PASSWORD=cocheraya_pass

# --- Seguridad JWT (Secreto HS256 de al menos 64 caracteres) ---
APP_JWT_SECRET=c2VjdXJlX2tleV9mb3JfY29jaGVyYXlhX2JhY2tlbmRfcHJvamVjdF8yMDI2X2RlcGxveW1lbnRfc2VjcmV0XzI1Ng==
APP_JWT_EXPIRATION=86400000

# --- Firebase Admin SDK (Opcional para notificaciones móviles) ---
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# --- Cloudinary (Almacenamiento de imágenes de cocheras) ---
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- Email (SMTP Gmail - Contraseña de aplicación de 16 caracteres) ---
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_16_caracteres

# --- CORS & Servidor ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://cocheraya.vercel.app
PORT=8080
server.port=8080
spring.jpa.hibernate.ddl-auto=update