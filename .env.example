# ============================================================
# CocheraYa — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como .env y completa los valores.
# ============================================================

# --- Base de Datos PostgreSQL / PostGIS ---
POSTGRES_DB=cocheraya_db
POSTGRES_USER=cocheraya_user
POSTGRES_PASSWORD=reemplaza_con_una_contrasena_segura
POSTGRES_PORT=5432

# --- Spring Datasource ---
# Ejecución local: jdbc:postgresql://localhost:5432/cocheraya_db
# Docker Compose reemplaza el host por el servicio cocheraya_db.
# AWS RDS se configura por separado en .env.prod.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cocheraya_db
SPRING_DATASOURCE_USERNAME=cocheraya_user
SPRING_DATASOURCE_PASSWORD=reemplaza_con_una_contrasena_segura

# --- Seguridad JWT (Secreto HS256 de al menos 64 caracteres) ---
APP_JWT_SECRET=reemplaza_con_un_secreto_aleatorio_de_al_menos_64_caracteres
APP_JWT_EXPIRATION=86400000

# --- Firebase Admin SDK (Opcional para notificaciones móviles) ---
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# --- Cloudinary (Almacenamiento de imágenes de cocheras) ---
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- Email (SMTP Gmail - Contraseña de aplicación de 16 caracteres) ---
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_16_caracteres

# --- CORS & Servidor ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://cocheraya.vercel.app
PORT=8080

# --- Configuración Spring JPA / Hibernate ---
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
