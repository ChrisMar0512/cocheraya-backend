# ============================================================
# ParkShare - Plantilla de Variables de Entorno (.env)
# Copia este archivo a .env en tu computadora y completa los valores.
# ============================================================

# --- Base de Datos PostgreSQL / PostGIS ---
POSTGRES_DB=parkshare
POSTGRES_USER=parkshare_user
POSTGRES_PASSWORD=parkshare_pass
POSTGRES_PORT=5432

# --- Spring Datasource ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/parkshare
SPRING_DATASOURCE_USERNAME=parkshare_user
SPRING_DATASOURCE_PASSWORD=parkshare_pass

# --- JWT ---
# Secreto de al menos 64 caracteres para firma HS256
APP_JWT_SECRET=cambia_este_secreto_por_uno_de_al_menos_64_caracteres_aleatorios_seguro
# Expiración del token en milisegundos (86400000 = 24 horas)
APP_JWT_EXPIRATION=86400000

# --- Firebase ---
# Ruta al archivo JSON de credenciales de Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# --- Cloudinary (Almacenamiento de imágenes de cocheras) ---
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- Email (SMTP - Envío de alertas y comprobantes) ---
MAIL_USERNAME=tu_correo_smtp@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion_smtp

# --- CORS ---
# Orígenes permitidos separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Configuración Spring JPA / Hibernate ---
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# --- Servidor ---
server.port=8080
