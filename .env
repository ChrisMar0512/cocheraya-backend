# ============================================================
# CocheraYa — Variables de entorno para la entrega académica
# IMPORTANTE: este archivo es público; no colocar secretos reales.
# ============================================================

# --- Base de Datos PostgreSQL / PostGIS ---
POSTGRES_DB=cocheraya_db
POSTGRES_USER=cocheraya_user
POSTGRES_PASSWORD=reemplaza_con_una_contrasena_segura
POSTGRES_PORT=5432

# --- Spring Datasource ---
# Local: jdbc:postgresql://localhost:5432/cocheraya_db
# En producción, reemplazar el host por el endpoint de AWS RDS.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cocheraya_db
SPRING_DATASOURCE_USERNAME=cocheraya_user
SPRING_DATASOURCE_PASSWORD=reemplaza_con_una_contrasena_segura

# --- Seguridad JWT ---
APP_JWT_SECRET=reemplaza_con_un_secreto_aleatorio_de_al_menos_64_caracteres
APP_JWT_EXPIRATION=86400000

# --- Firebase Admin SDK ---
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- Email SMTP ---
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://cocheraya.vercel.app

# --- Configuración Spring JPA / Hibernate ---
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# --- Servidor ---
PORT=8080
